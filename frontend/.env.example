# URL base del backend. Por defecto usa http://localhost:4000 si no se define.
VITE_API_BASE_URL=http://localhost:4000

# API key de Google Maps Platform (Places API) para el autocompletado de
# direcciones (nuevo paciente, configuración del consultorio). Sin esta
# variable, esos campos funcionan como texto libre sin sugerencias.
VITE_GOOGLE_MAPS_API_KEY=
