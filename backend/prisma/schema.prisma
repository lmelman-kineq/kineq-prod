// moduleFormat/importFileExtension fuerzan salida CJS con especificadores
// .ts (en vez de .js) para que el cliente generado funcione bajo ts-node-dev
// en modo transpile-only; con la config por defecto (ESM) el runtime de
// Node 26 carga el archivo dos veces (una vez como CJS y otra como ESM
// nativo por `import.meta`) y falla con "exports is not defined".
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "mysql"
}

enum EstadoTurno {
  ASIGNADO
  EN_ESPERA
  ATENDIENDO
  FINALIZADO
  AUSENTE
  CANCELADO
}

enum RolUsuario {
  ADMINISTRADOR
  PROFESIONAL
  RECEPCION
  SUPERVISOR
}

enum EstadoFichaInicial {
  BORRADOR
  COMPLETA
}

enum EstadoDatoClinico {
  SI
  NO
  NO_INFORMA
}

enum CategoriaCatalogoClinico {
  ANTECEDENTE_PERSONAL
  ANTECEDENTE_FAMILIAR
  PROCEDIMIENTO_QUIRURGICO
  ALERGIA
}

enum GravedadAlergia {
  LEVE
  MODERADA
  GRAVE
}

enum SeccionFicha {
  MOTIVO
  ANTECEDENTES
  SEGURIDAD
  HABITOS
  DOLOR_FUNCION
  ESTUDIOS
}

enum EstadoRevisionSeccion {
  PENDIENTE
  EN_PROGRESO
  REVISADA
}

model Consultorio {
  id          Int      @id @default(autoincrement())
  nombre      String
  slug        String   @unique
  email       String?
  telefono    String?
  direccion   String?
  ciudad      String?
  provincia   String?
  zonaHoraria String   @default("America/Argentina/Buenos_Aires")
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pacientes                 Paciente[]
  profesionales             Profesional[]
  especialidades            Especialidad[]
  obrasSociales             ObraSocial[]
  turnos                    Turno[]
  evoluciones               Evolucion[]
  profesionalEspecialidades ProfesionalEspecialidad[]
  usuarios                  Usuario[]
  fichasIniciales           FichaInicial[]
  fichaAntecedentes         FichaAntecedente[]
  fichaAlergias             FichaAlergia[]
  fichaMedicaciones         FichaMedicacion[]
  fichaEstudios             FichaEstudioComplementario[]
  fichaSeccionesEstado      FichaSeccionEstado[]
  catalogoClinicoItems      CatalogoClinicoItem[]
  especialidadesOcultas     ConsultorioEspecialidadOculta[]
  obrasSocialesOcultas      ConsultorioObraSocialOculta[]
  fichaAlertasCampo         FichaAlertaCampo[]
  gruposEvolucion           GrupoEvolucion[]
  plantillasEvolucion       PlantillaEvolucion[]

  @@index([activo])
}

model Usuario {
  id            Int        @id @default(autoincrement())
  consultorioId Int
  nombre        String
  apellido      String
  email         String     @unique
  passwordHash  String
  rol           RolUsuario
  activo        Boolean    @default(true)
  profesionalId Int?       @unique
  // Foto de perfil: igual criterio que EvolucionImagen — solo la referencia
  // al blob (privado), nunca la URL ni el binario. `fotoMimeType` alcanza
  // para servirla (avatar, sin nombre de archivo visible en ningún lado).
  fotoPathname  String?    @db.Text
  fotoMimeType  String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  consultorio Consultorio  @relation(fields: [consultorioId], references: [id])
  profesional Profesional? @relation(fields: [profesionalId], references: [id])

  @@index([consultorioId])
}

model Paciente {
  id              Int       @id @default(autoincrement())
  consultorioId   Int
  nombre          String
  apellido        String
  documento       String?
  fechaNacimiento DateTime?
  email           String?
  telefono        String?
  direccion       String?
  obraSocialId    Int?
  numeroAfiliado  String?
  observaciones   String?
  activo          Boolean   @default(true)
  // Foto/avatar del paciente — mismo criterio que Usuario.fotoPathname.
  fotoPathname    String?   @db.Text
  fotoMimeType    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  consultorio     Consultorio      @relation(fields: [consultorioId], references: [id])
  obraSocial      ObraSocial?      @relation(fields: [obraSocialId], references: [id])
  turnos          Turno[]
  evoluciones     Evolucion[]
  fichaInicial    FichaInicial?
  gruposEvolucion GrupoEvolucion[]

  // Único por consultorio cuando hay documento — MySQL no deduplica NULLs,
  // así que pacientes sin documento (el caso normal ahora que es opcional)
  // no chocan entre sí.
  @@unique([consultorioId, documento])
  @@index([consultorioId, activo])
  @@index([consultorioId, apellido, nombre])
  @@index([obraSocialId])
}

model Profesional {
  id            Int       @id @default(autoincrement())
  consultorioId Int
  nombre        String
  apellido      String
  titulo        String?
  matricula     String?
  email         String?
  telefono      String?
  activo        Boolean   @default(true)
  // Baja lógica/archivo — distinto de `activo`: un profesional inactivo
  // (`activo:false`, `deletedAt:null`) sigue siendo administrable y
  // reactivable; uno archivado (`deletedAt` seteado, que además siempre
  // implica `activo:false`) queda fuera de los listados normales de
  // Configuración. Nunca se borra físicamente si tiene historial (turnos o
  // evoluciones) — ver DELETE /api/profesionales/:id.
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  consultorio       Consultorio                  @relation(fields: [consultorioId], references: [id])
  especialidades    ProfesionalEspecialidad[]
  turnos            Turno[]
  evoluciones       Evolucion[]
  usuario           Usuario?
  fichasResponsable FichaInicial[]
  estudios          FichaEstudioComplementario[]

  @@index([consultorioId, activo])
  @@index([consultorioId, apellido, nombre])
  @@index([consultorioId, matricula])
}

// Catálogo global/custom, mismo patrón que CatalogoClinicoItem: filas de
// sistema (esSistema=true, consultorioId=null) administradas por Kineq, +
// filas custom por consultorio (esSistema=false, consultorioId siempre
// presente). El índice único es (consultorioId, nombre): para las filas de
// sistema (consultorioId NULL) MySQL no dedupe NULLs, así que esa unicidad
// depende de que solo el seed las cree (controlado, sin duplicados por
// diseño); para las filas custom, consultorioId nunca es NULL y el índice
// sí protege de verdad.
model Especialidad {
  id            Int      @id @default(autoincrement())
  consultorioId Int?
  esSistema     Boolean  @default(false)
  nombre        String
  color         String
  activo        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Cascade explícito, mismo motivo que CatalogoClinicoItem.consultorio: si
  // un consultorio se borra, sus especialidades custom se van con él, nunca
  // deben "flotar" a consultorioId NULL y volverse globales.
  consultorio   Consultorio?                    @relation(fields: [consultorioId], references: [id], onDelete: Cascade)
  profesionales ProfesionalEspecialidad[]
  turnos        Turno[]
  ocultaPara    ConsultorioEspecialidadOculta[]

  @@unique([consultorioId, nombre])
  @@index([consultorioId, activo])
  @@index([esSistema, activo])
}

// Ocultamiento de una especialidad global (esSistema=true) para un
// consultorio puntual: no la borra ni la desactiva globalmente, solo la
// saca de los listados/selects de ese consultorio — el resto de los
// consultorios la sigue viendo sin cambios.
model ConsultorioEspecialidadOculta {
  consultorioId  Int
  especialidadId Int
  createdAt      DateTime @default(now())

  consultorio  Consultorio  @relation(fields: [consultorioId], references: [id], onDelete: Cascade)
  especialidad Especialidad @relation(fields: [especialidadId], references: [id], onDelete: Cascade)

  @@id([consultorioId, especialidadId])
  @@index([especialidadId])
}

model ProfesionalEspecialidad {
  consultorioId  Int
  profesionalId  Int
  especialidadId Int
  createdAt      DateTime @default(now())

  consultorio  Consultorio  @relation(fields: [consultorioId], references: [id])
  profesional  Profesional  @relation(fields: [profesionalId], references: [id])
  especialidad Especialidad @relation(fields: [especialidadId], references: [id])

  @@id([profesionalId, especialidadId])
  @@index([consultorioId])
  @@index([especialidadId])
}

// Catálogo global/custom — mismo patrón y mismas notas que Especialidad.
model ObraSocial {
  id            Int      @id @default(autoincrement())
  consultorioId Int?
  esSistema     Boolean  @default(false)
  nombre        String
  activo        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  consultorio Consultorio?                  @relation(fields: [consultorioId], references: [id], onDelete: Cascade)
  pacientes   Paciente[]
  turnos      Turno[]
  ocultaPara  ConsultorioObraSocialOculta[]

  @@unique([consultorioId, nombre])
  @@index([consultorioId, activo])
  @@index([esSistema, activo])
}

model ConsultorioObraSocialOculta {
  consultorioId Int
  obraSocialId  Int
  createdAt     DateTime @default(now())

  consultorio Consultorio @relation(fields: [consultorioId], references: [id], onDelete: Cascade)
  obraSocial  ObraSocial  @relation(fields: [obraSocialId], references: [id], onDelete: Cascade)

  @@id([consultorioId, obraSocialId])
  @@index([obraSocialId])
}

model Turno {
  id               Int         @id @default(autoincrement())
  consultorioId    Int
  pacienteId       Int
  profesionalId    Int
  especialidadId   Int
  obraSocialId     Int?
  // Diagnóstico (GrupoEvolucion) al que pertenece este turno, opcional. Con
  // un diagnóstico que tiene `cantidadSesionesPlanificadas`, habilita el
  // cálculo automático de `numeroSesion` como "sesión completada + 1" —
  // ver `sesionAutomaticaParaGrupo()` en app.ts. Nunca obligatorio: un
  // turno sin diagnóstico sigue funcionando exactamente igual que antes.
  grupoId          Int?
  inicio           DateTime
  duracionMinutos  Int         @default(60)
  numeroSesion     Int?
  // Turno administrativo/de evaluación que no consume un número de sesión
  // del plan de tratamiento: nunca recibe numeroSesion automático ni cuenta
  // para el conteo de otros turnos del mismo paciente+diagnóstico (ver
  // sesionAutomaticaParaGrupo() en app.ts). Explícito a propósito — nunca se
  // infiere de numeroSesion === null, que también puede pasar por otros
  // motivos (turno sin diagnóstico, por ejemplo).
  esSesionConsulta Boolean     @default(false)
  // Monto cobrado por el turno, opcional — dato administrativo simple, sin
  // ningún cálculo/suma agregada pedido todavía (si eso llega a hacer
  // falta más adelante, ahí sí conviene migrar a Decimal para evitar
  // arrastre de error de punto flotante en sumas; para un campo mostrado
  // tal cual, Float alcanza y evita sumarle a este proyecto su primer
  // campo Decimal, que Prisma serializa como string, no number).
  monto            Float?
  notas            String?
  estado           EstadoTurno @default(ASIGNADO)
  inicioAtencion   DateTime?
  finAtencion      DateTime?
  canceladoAt      DateTime?
  // Baja lógica — nunca DELETE físico. La FK Evolucion.turnoId ya es
  // onDelete: SetNull, así que un delete físico no destruiría evoluciones,
  // pero SÍ desaparecería silenciosamente de estadísticas históricas
  // (sesiones realizadas/ausentismo de meses ya cerrados). Con esto, un
  // turno "eliminado" sale de toda lectura operativa (agenda, Paciente,
  // estadísticas) pero la fila y su `estado`/timestamps quedan intactos.
  eliminadoAt      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  consultorio  Consultorio     @relation(fields: [consultorioId], references: [id])
  paciente     Paciente        @relation(fields: [pacienteId], references: [id])
  profesional  Profesional     @relation(fields: [profesionalId], references: [id])
  especialidad Especialidad    @relation(fields: [especialidadId], references: [id])
  obraSocial   ObraSocial?     @relation(fields: [obraSocialId], references: [id])
  grupo        GrupoEvolucion? @relation(fields: [grupoId], references: [id], onDelete: SetNull)
  evoluciones  Evolucion[]

  @@index([consultorioId, inicio])
  @@index([consultorioId, profesionalId, inicio])
  @@index([consultorioId, pacienteId, inicio])
  @@index([consultorioId, estado, inicio])
  @@index([especialidadId])
  @@index([obraSocialId])
  @@index([grupoId])
}

model Evolucion {
  id            Int      @id @default(autoincrement())
  consultorioId Int
  pacienteId    Int
  profesionalId Int
  turnoId       Int?
  grupoId       Int?
  // `@db.Text` (no el VARCHAR(191) por default de Prisma en MySQL): una
  // evolución larga superaba los 191 caracteres y el INSERT fallaba en la
  // base con "Data too long for column 'contenido'", devuelto como 500
  // genérico. `contenidoHtml` ya tenía este mismo fix desde que se agregó
  // el formato rico (ver comentario original, movido acá) — quedó pendiente
  // aplicarlo también a `contenido`, el campo que sí existe desde el inicio.
  contenido     String   @db.Text
  // Formato básico (negrita/cursiva/subrayado) — HTML ya sanitizado contra
  // una allowlist estricta (ver backend/src/sanitizeRichText.ts), nunca
  // HTML crudo del cliente. Nulo para evoluciones sin formato aplicado
  // (incluidas todas las anteriores a esta funcionalidad): en ese caso se
  // sigue mostrando `contenido` como texto plano, comportamiento sin
  // cambios.
  contenidoHtml String?  @db.Text
  activo        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  consultorio Consultorio       @relation(fields: [consultorioId], references: [id])
  paciente    Paciente          @relation(fields: [pacienteId], references: [id])
  profesional Profesional       @relation(fields: [profesionalId], references: [id])
  turno       Turno?            @relation(fields: [turnoId], references: [id])
  grupo       GrupoEvolucion?   @relation(fields: [grupoId], references: [id], onDelete: SetNull)
  imagenes    EvolucionImagen[]

  @@index([consultorioId, pacienteId, createdAt])
  @@index([consultorioId, profesionalId, createdAt])
  @@index([turnoId])
  @@index([grupoId])
}

// Imágenes adjuntas a una evolución (fotos clínicas). El binario vive en
// Vercel Blob (`access: 'private'`), nunca en MySQL — acá solo se guarda la
// referencia. `pathname` es la clave dentro del blob store: la usan tanto
// `del()` (al sacar una imagen) como `get()` (al servirla) — ver
// `backend/src/blobStorage.ts`. No hay columna `url`: el frontend nunca
// recibe la URL de Vercel Blob (privada, inservible sin el token del
// servidor), solo la ruta propia `/api/evoluciones/:evolucionId/imagenes/:id/contenido`,
// que valida consultorio/paciente/evolución antes de servir el contenido —
// ver `evolucionImagenesRoutes.ts`.
model EvolucionImagen {
  id             Int      @id @default(autoincrement())
  consultorioId  Int
  pacienteId     Int
  evolucionId    Int
  pathname       String   @db.Text
  nombreOriginal String
  mimeType       String
  sizeBytes      Int
  createdAt      DateTime @default(now())

  evolucion Evolucion @relation(fields: [evolucionId], references: [id], onDelete: Cascade)

  @@index([consultorioId, evolucionId])
  @@index([pacienteId])
}

// Agrupación de evoluciones/turnos (ej. "Lumbalgia") — no es una entidad
// clínica formal completa: no tiene severidad, objetivos por sesión ni alta
// médica. `cantidadSesionesPlanificadas` es lo único que se le agregó de
// "plan": opcional, habilita mostrar/calcular "Sesión X de Y" en los turnos
// asociados (ver `sesionAutomaticaParaGrupo()` en app.ts) — sin ella, un
// grupo se comporta exactamente como antes. Eliminar un grupo nunca borra
// evoluciones ni turnos: ambas FKs (`Evolucion.grupoId`, `Turno.grupoId`)
// usan onDelete: SetNull, quedan "Sin diagnóstico" y conservan su contenido.
model GrupoEvolucion {
  id                           Int      @id @default(autoincrement())
  consultorioId                Int
  pacienteId                   Int
  nombre                       String
  color                        String
  cantidadSesionesPlanificadas Int?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  consultorio Consultorio @relation(fields: [consultorioId], references: [id])
  paciente    Paciente    @relation(fields: [pacienteId], references: [id])
  evoluciones Evolucion[]
  turnos      Turno[]

  @@unique([pacienteId, nombre])
  @@index([consultorioId, pacienteId])
}

// Plantilla reutilizable de contenido para Evoluciones (V1) — atajo para no
// re-tipear una estructura recurrente (ej. una evaluación cervical
// estándar) cada vez que se carga una evolución nueva. Siempre de
// consultorio, nunca global (a diferencia de Especialidad/
// CatalogoClinicoItem, acá no hay noción "de sistema") ni asociada a un
// Profesional en particular: cualquier ADMINISTRADOR/PROFESIONAL del
// consultorio la puede usar/crear/editar/archivar por igual. `activo:false`
// es baja lógica (nunca se borra físicamente si ya se usó como referencia
// visual en algún momento — igual que GrupoEvolucion no se borra
// evoluciones, acá directamente no hay relación a preservar: aplicar una
// plantilla solo copia texto una vez, no deja rastro en la Evolución
// resultante).
model PlantillaEvolucion {
  id            Int      @id @default(autoincrement())
  consultorioId Int
  nombre        String
  contenido     String   @db.Text
  contenidoHtml String?  @db.Text
  activo        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  consultorio Consultorio @relation(fields: [consultorioId], references: [id], onDelete: Cascade)

  @@index([consultorioId, activo])
}

// Ficha clínica inicial del paciente. 1:1 con Paciente, editable y guardable
// parcialmente (estado BORRADOR); no bloquea el resto del flujo de atención.
model FichaInicial {
  id                       Int                @id @default(autoincrement())
  consultorioId            Int
  pacienteId               Int                @unique
  profesionalResponsableId Int?
  motivoConsulta           String?
  fechaInicioProblema      DateTime?
  diagnosticoDerivacion    String?
  objetivoPaciente         String?
  antecedentesPersonales   String?
  antecedentesFamiliares   String?
  cirugias                 String?
  traumatismosAccidentes   String?
  tratamientosPrevios      String?
  alergiasEstado           EstadoDatoClinico?
  medicacionEstado         EstadoDatoClinico?
  enfermedadesActuales     String?
  actividadFisica          String?
  deportes                 String?
  ocupacion                String?
  limitacionesFuncionales  String?
  estudiosComplementarios  String?
  dolorSintomas            String?
  hallazgosIniciales       String?
  observacionesClinicas    String?

  // Hábitos: columnas escalares directas (no ameritan tabla propia, son
  // 1:1 con la ficha, sin semántica de lista/historial).
  tabaquismoEstado    EstadoDatoClinico?
  aniosFumador        Int?
  cigarrillosDiarios  Int?
  alcoholEstado       EstadoDatoClinico?
  sedentarismoEstado  EstadoDatoClinico?
  ejercicioMinutosDia Int?

  // Contexto gineco-obstétrico: opcional, nunca obligatorio, presentado en
  // la UI como sección colapsable (no restringido por sexo/género en los datos).
  menarcaEstado       EstadoDatoClinico?
  edadMenarca         Int?
  menopausiaEstado    EstadoDatoClinico?
  edadMenopausia      Int?
  gestas              Int?
  partos              Int?
  abortos             Int?
  observacionesGineco String?

  estado    EstadoFichaInicial @default(BORRADOR)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  consultorio            Consultorio  @relation(fields: [consultorioId], references: [id])
  paciente               Paciente     @relation(fields: [pacienteId], references: [id])
  profesionalResponsable Profesional? @relation(fields: [profesionalResponsableId], references: [id])

  antecedentes    FichaAntecedente[]
  alergias        FichaAlergia[]
  medicaciones    FichaMedicacion[]
  estudios        FichaEstudioComplementario[]
  seccionesEstado FichaSeccionEstado[]
  alertasCampo    FichaAlertaCampo[]

  @@index([consultorioId])
  @@index([profesionalResponsableId])
}

// Alerta clínica manual sobre un campo de texto libre de la Ficha Inicial
// (Motivo, Traumatismos, Tratamientos previos, Dolor y función, etc.) — a
// diferencia de Antecedentes/Medicación, esos campos son columnas escalares
// sueltas en FichaInicial, no filas de catálogo, así que no hay una columna
// booleana natural donde colgar el flag. La existencia de la fila ES la
// alerta: marcar = crear, desmarcar = borrar, sin columna `activa`. `campo`
// se valida contra una whitelist fija en el backend (ELIGIBLE_ALERT_FIELDS).
model FichaAlertaCampo {
  id             Int      @id @default(autoincrement())
  consultorioId  Int
  fichaInicialId Int
  campo          String
  createdAt      DateTime @default(now())

  consultorio  Consultorio  @relation(fields: [consultorioId], references: [id])
  fichaInicial FichaInicial @relation(fields: [fichaInicialId], references: [id], onDelete: Cascade)

  @@unique([fichaInicialId, campo])
  @@index([consultorioId])
}

// Catálogo clínico extensible: ítems de sistema (esSistema=true,
// consultorioId=null, sembrados por seed.ts) + ítems personalizados por
// consultorio (esSistema=false, consultorioId siempre presente).
// El índice único es (consultorioId, categoria, codigo): para las filas de
// sistema (consultorioId NULL) MySQL no deduplica entre NULLs, así que esa
// unicidad depende de que solo el seed las cree (controlado, sin duplicados
// por diseño); para las filas personalizadas consultorioId nunca es NULL,
// así que ahí el índice sí protege de verdad — dos consultorios distintos
// pueden tener cada uno su propio ítem personalizado con el mismo nombre
// sin chocar entre sí.
model CatalogoClinicoItem {
  id            Int                      @id @default(autoincrement())
  categoria     CategoriaCatalogoClinico
  codigo        String
  nombre        String
  descripcion   String?
  esSistema     Boolean                  @default(true)
  consultorioId Int?
  activo        Boolean                  @default(true)
  orden         Int                      @default(0)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  // Cascade explícito: si un consultorio se borra, sus ítems de catálogo
  // personalizados se van con él — nunca deben "flotar" a consultorioId
  // NULL y volverse visibles globalmente (eso fue un bug real: la FK sin
  // onDelete explícito quedó en SET NULL por default, y los ítems de
  // catálogo de un consultorio de prueba borrado terminaron viéndose desde
  // cualquier otro consultorio).
  consultorio  Consultorio?       @relation(fields: [consultorioId], references: [id], onDelete: Cascade)
  antecedentes FichaAntecedente[]
  alergias     FichaAlergia[]

  @@unique([consultorioId, categoria, codigo])
  @@index([categoria, activo])
  @@index([consultorioId])
}

// Antecedentes personales, familiares y quirúrgicos: una sola tabla,
// discriminada por `catalogoItem.categoria`. `NO_INFORMA` nunca se persiste
// como fila explícita — es el estado implícito por ausencia de respuesta.
model FichaAntecedente {
  id              Int               @id @default(autoincrement())
  consultorioId   Int
  fichaInicialId  Int
  catalogoItemId  Int
  estado          EstadoDatoClinico
  detalle         String?
  fechaAproximada DateTime?
  edadAproximada  Int?
  parentesco      String?
  esAlertaClinica Boolean           @default(false)
  activo          Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  consultorio  Consultorio         @relation(fields: [consultorioId], references: [id])
  fichaInicial FichaInicial        @relation(fields: [fichaInicialId], references: [id])
  catalogoItem CatalogoClinicoItem @relation(fields: [catalogoItemId], references: [id])

  @@unique([fichaInicialId, catalogoItemId])
  @@index([consultorioId])
}

model FichaAlergia {
  id             Int              @id @default(autoincrement())
  consultorioId  Int
  fichaInicialId Int
  catalogoItemId Int?
  nombreLibre    String?
  reaccion       String?
  gravedad       GravedadAlergia?
  observaciones  String?
  activa         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  consultorio  Consultorio          @relation(fields: [consultorioId], references: [id])
  fichaInicial FichaInicial         @relation(fields: [fichaInicialId], references: [id])
  catalogoItem CatalogoClinicoItem? @relation(fields: [catalogoItemId], references: [id])

  @@index([consultorioId])
  @@index([fichaInicialId])
}

// Sin catálogo farmacológico: `nombre` es texto libre a propósito.
model FichaMedicacion {
  id              Int      @id @default(autoincrement())
  consultorioId   Int
  fichaInicialId  Int
  nombre          String
  dosis           String?
  unidad          String?
  frecuencia      String?
  via             String?
  motivo          String?
  observaciones   String?
  esAlertaClinica Boolean  @default(false)
  activa          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  consultorio  Consultorio  @relation(fields: [consultorioId], references: [id])
  fichaInicial FichaInicial @relation(fields: [fichaInicialId], references: [id])

  @@index([consultorioId])
  @@index([fichaInicialId])
}

// Entradas individuales de estudios complementarios. El campo de texto libre
// `estudiosComplementarios` en FichaInicial se mantiene como nota general;
// esto es para registros puntuales con fecha. Sin `documentoId` todavía —
// la carga real de archivos está fuera de alcance.
model FichaEstudioComplementario {
  id                    Int       @id @default(autoincrement())
  consultorioId         Int
  fichaInicialId        Int
  profesionalId         Int?
  tipo                  String
  fecha                 DateTime?
  resumen               String?
  observaciones         String?
  activo                Boolean   @default(true)
  // Archivo adjunto (PDF/imagen del estudio) — un archivo por entrada, mismo
  // criterio que EvolucionImagen/Usuario.fotoPathname: solo la referencia al
  // blob privado, nunca la URL ni el binario. Todos nullable: la mayoría de
  // los estudios existentes no tiene archivo cargado.
  archivoPathname       String?   @db.Text
  archivoNombreOriginal String?
  archivoMimeType       String?
  archivoSizeBytes      Int?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  consultorio  Consultorio  @relation(fields: [consultorioId], references: [id])
  fichaInicial FichaInicial @relation(fields: [fichaInicialId], references: [id])
  profesional  Profesional? @relation(fields: [profesionalId], references: [id])

  @@index([consultorioId])
  @@index([fichaInicialId])
}

model FichaSeccionEstado {
  id             Int                   @id @default(autoincrement())
  consultorioId  Int
  fichaInicialId Int
  seccion        SeccionFicha
  estado         EstadoRevisionSeccion @default(PENDIENTE)
  updatedAt      DateTime              @updatedAt

  consultorio  Consultorio  @relation(fields: [consultorioId], references: [id])
  fichaInicial FichaInicial @relation(fields: [fichaInicialId], references: [id])

  @@unique([fichaInicialId, seccion])
  @@index([consultorioId])
}
